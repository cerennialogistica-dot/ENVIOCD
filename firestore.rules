rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Todo acesso exige login válido.
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // PEDIDOS: podem ser criados, nunca apagados.
    // Os dados originais do pedido também ficam protegidos contra alteração.
    match /pedidos/{pedidoId} {
      allow create: if request.auth != null;

      allow update: if request.auth != null
        && request.resource.data.numero == resource.data.numero
        && request.resource.data.usuario == resource.data.usuario
        && request.resource.data.destino == resource.data.destino
        && request.resource.data.dataHora == resource.data.dataHora
        && request.resource.data.criadoMs == resource.data.criadoMs
        && request.resource.data.criadoPorUid == resource.data.criadoPorUid
        && request.resource.data.criadoPorLogin == resource.data.criadoPorLogin
        && request.resource.data.itens == resource.data.itens;

      allow delete: if false;
    }

    // Contador, produtos, usuários operacionais e perfis.
    match /configuracoes/{docId} {
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    match /produtos/{docId} {
      allow create, update, delete: if request.auth != null;
    }

    match /usuarios/{docId} {
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    match /acessos/{docId} {
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
